{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 自分の Cloudflare アカウントで配信する Worker。
  // Workers Builds（GitHub 連携）: ビルド `npm run build:cloudflare` / デプロイ `npm run deploy:cloudflare`
  // （デプロイ前に `emdash migrate` で D1 のコアマイグレーションを適用する）
  "name": "tv-fit",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Workers Paid（2026-11-17 契約）。1リクエストあたりのCPU時間上限を 30 秒にする。
  // 無料プラン（10ms）では EmDash の一覧・保存が頻繁に「CPU時間制限超過」で失敗していた。
  "limits": { "cpu_ms": 30000 },
  "vars": {
    "EMDASH_SITE_URL": "https://tv-fit.com",
    "PUBLIC_SITE_URL": "https://tv-fit.com"
  },
  // database_id / bucket は初回デプロイ時に Wrangler が自動作成する。
  "d1_databases": [
    { "binding": "DB", "database_name": "tv-fit-emdash" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tv-fit-emdash-media" }
  ]
}
