{
  "name": "tv-stand-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "validate:data": "tsx scripts/validate-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run validate:data && astro build && node scripts/build-sites-worker.mjs",
    "build:cloudflare": "npm run validate:data && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "verify": "npm run check && npm test && npm run build && npm run verify:build",
    "verify:build": "node scripts/verify-cms-build.mjs",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "cms:import": "tsx scripts/cms-import.ts",
    "cms:export": "tsx scripts/cms-export.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@astrojs/react": "7.1.4",
    "@cloudflare/workers-types": "5.20261109.1",
    "@emdash-cms/cloudflare": "1.4.0",
    "@tailwindcss/vite": "4.3.5",
    "@tv-fit/validation": "file:plugins/tv-fit-validation",
    "astro": "7.4.7",
    "csv-parse": "7.0.3",
    "emdash": "1.4.0",
    "fuse.js": "7.5.0",
    "kysely": "0.29.8",
    "pako": "3.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "unstorage": "2.0.0-beta.0",
    "wrangler": "4.125.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261101.0-beta",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
