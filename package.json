{
  "name": "tv-stand-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "validate:data": "tsx scripts/validate-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run validate:data && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "verify": "npm run check && npm test && npm run build && npm run verify:build",
    "verify:build": "tsx scripts/verify-build.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "csv-parse": "7.0.3",
    "fuse.js": "7.5.0",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "cheerio": "1.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
