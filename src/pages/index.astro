---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import VesaIllustration from '../components/VesaIllustration.astro';
import type {Catalog} from '../lib/data';
import {getPublishedCatalog} from '../lib/cms-catalog';
import {getManufacturers} from '../lib/manufacturers';
interface Props { catalog?: Catalog; }
const catalog = Astro.props.catalog ?? await getPublishedCatalog();
const manufacturers = getManufacturers(catalog.televisions);
---
<BaseLayout title="テレビのメーカーからスタンド・壁掛け金具を探す｜TV FIT" description="お使いのテレビのメーカーを選び、型番一覧からテレビを選択。テレビスタンドや壁掛け金具の適合情報と、VESA・重量・確認の根拠を確認できます。">
  <section class="hero manufacturer-home-hero container">
    <div class="hero-copy"><p class="eyebrow"><span></span> テレビスタンド選びを、もっと確かに。</p><h1>まずは、テレビの<br/><span>メーカー</span>を選ぶ。</h1><p class="hero-description">メーカーを選んだら、次のページでテレビの型番を選択。<br class="desktop-break"/>対応するスタンド・壁掛け金具を確認できます。</p><ol class="selection-progress" aria-label="対応情報を確認する手順"><li aria-current="step"><span>1</span>メーカー</li><li><span>2</span>テレビの型番</li><li><span>3</span>対応情報</li></ol></div>
    <div class="hero-visual"><span class="visual-label">FIND YOUR TV’S PERFECT FIT</span><VesaIllustration /></div>
  </section>
  <section id="manufacturers" class="container manufacturer-selection" aria-labelledby="manufacturer-title">
    <div class="manufacturer-picker">
      <div class="manufacturer-picker-heading"><span class="search-panel-number">01</span><div><p class="eyebrow">SELECT MANUFACTURER</p><h2 id="manufacturer-title">テレビのメーカーを選んでください</h2></div><span class="selection-step-label">STEP 1 / 3</span></div>
      <p class="manufacturer-picker-description">お使いのテレビのメーカーをクリックすると、型番一覧に進みます。</p>
      <div class="manufacturer-grid">{manufacturers.map((manufacturer,index)=><a class="manufacturer-card" href={manufacturer.url} data-manufacturer-link aria-label={`${manufacturer.name}のテレビ型番一覧へ`}><span class:list={['manufacturer-wordmark',`manufacturer-${index % 7}`]}>{manufacturer.name}</span><span class="manufacturer-card-bottom">型番一覧へ <Icon name="arrow" size={16}/></span></a>)}</div>
      <p class="manufacturer-picker-note"><Icon name="info" size={15}/> メーカー名は、テレビ本体のロゴや背面ラベルで確認できます。</p>
    </div>
  </section>
  <section class="container manufacturer-home-help"><div class="guide-card"><div class="guide-card-icon"><Icon name="book" size={29}/></div><div><p class="eyebrow">BEFORE YOU CHOOSE</p><h2>型番やVESAの確認方法がわからないときは</h2><p>型番の確認場所と、テレビ背面の取付穴を確認する方法をご案内します。</p></div><a class="button-secondary" href="/guides/vesa/">確認方法を見る <Icon name="arrow" size={17}/></a></div></section>
</BaseLayout>
