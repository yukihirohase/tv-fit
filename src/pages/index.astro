---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type {Catalog} from '../lib/data';
import {getPublishedCatalog} from '../lib/cms-catalog';
import {getManufacturers} from '../lib/manufacturers';
interface Props { catalog?: Catalog; }
const catalog = Astro.props.catalog ?? await getPublishedCatalog({compatibility:'none'});
const manufacturers = getManufacturers(catalog.televisions);
---
<BaseLayout title="テレビのメーカーからスタンド・壁掛け金具を探す｜TV FIT" description="お使いのテレビのメーカーを選び、型番一覧からテレビを選択。テレビスタンドや壁掛け金具の適合情報と、VESA・重量・確認の根拠を確認できます。">
  <!-- ファーストビュー：まずメーカーを選ぶことが一目でわかるように、選ぶボタンと3ステップをカードにまとめる -->
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <p class="home-eyebrow">Find your TV’s perfect fit</p>
        <h1 id="home-title">テレビスタンド選びを、<br/>もっと確かに。</h1>
        <p class="home-lead">型番から、ぴったり合うスタンド・壁掛け金具がわかります。<span class="home-pc-only"><br/>すっきり整ったテレビまわりを、迷わずに。</span></p>
        <div class="home-first-step">
          <p class="home-first-step-title">まずは、テレビの<br class="home-sp-only"/><em>メーカー</em>を選ぶ。</p>
          <p class="home-first-step-text">次のページで型番を選ぶと、対応するスタンド・壁掛け金具を確認できます。</p>
          <a class="home-cta" href="#manufacturers">メーカーを選ぶ <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg></a>
          <ol class="home-steps" aria-label="対応情報を確認する手順">
            <li aria-current="step"><span>1</span>メーカー</li>
            <li><span>2</span>型番</li>
            <li><span>3</span>対応情報</li>
          </ol>
        </div>
        <a class="home-help-link" href="#guide"><Icon name="info" size={18}/>型番やVESAの確認方法がわからないときは</a>
      </div>
      <div class="home-hero-visual">
        <!--
          メインビジュアル：public/images/home/hero-living-stand-{1536,800}.webp（元画像 3:2、1536×1024）。
          PC は 4:3、スマホは 16:10 に切り抜いて表示する（object-position でテレビとスタンドの足元を残す）。
          差し替えるときの条件：自然光の入るリビング。床置きスタンドの55〜65型テレビ。支柱と足元が見え、配線が隠れている状態。
          画面の番組・ロゴ・人物の顔は写さない。
        -->
        <figure class="home-photo">
          <img src="/images/home/hero-living-stand-1536.webp" srcset="/images/home/hero-living-stand-800.webp 800w, /images/home/hero-living-stand-1536.webp 1536w" sizes="(max-width: 900px) 100vw, 600px" width="1536" height="1024" alt="スタンドに設置したテレビのあるリビング" fetchpriority="high"/>
        </figure>
        <div class="home-vesa-card" aria-hidden="true">
          <svg viewBox="0 0 200 120" width="100%">
            <rect x="30" y="10" width="140" height="92" rx="6" fill="#E8E0D4" stroke="#D6CBBB"/>
            <g fill="#FFFDF9" stroke="#7C5B3E" stroke-width="2"><circle cx="70" cy="40" r="5"/><circle cx="130" cy="40" r="5"/><circle cx="70" cy="80" r="5"/><circle cx="130" cy="80" r="5"/></g>
            <path d="M70 26H130M70 22v8M130 22v8M182 40V80M178 40h8M178 80h8" stroke="#1262ce" stroke-width="1.5"/>
            <text x="100" y="20" text-anchor="middle" font-size="10" fill="#1262ce">横の間隔</text>
          </svg>
          <p><strong>VESA</strong>：テレビ背面の取付穴の間隔。これが合うかどうかで、取り付けられるかが決まります。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STEP 1：メーカー選択 -->
  <section id="manufacturers" class="home-section home-makers" aria-labelledby="manufacturer-title">
    <div class="container">
      <p class="home-step-badge"><span>STEP 1 / 3</span>メーカーを選ぶ</p>
      <h2 id="manufacturer-title">テレビのメーカーを<br class="home-sp-only"/>選んでください</h2>
      <p class="home-section-lead">メーカーを押すと、型番の一覧に進みます。</p>
      <ul class="home-maker-grid">
        {manufacturers.map(manufacturer => <li><a class="manufacturer-card" href={manufacturer.url} data-manufacturer-link aria-label={`${manufacturer.name}のテレビ型番一覧へ`}><span class="home-maker-name">{manufacturer.name}</span><span class="home-maker-sub">型番一覧へ</span></a></li>)}
        <li><a class="home-maker-unknown" href="#guide"><span class="home-maker-name">メーカー・型番が<br/>わからない</span><span class="home-maker-sub">確認方法へ</span></a></li>
      </ul>
      <p class="home-maker-note"><Icon name="info" size={18}/>メーカー名は、テレビ本体の前面のロゴや、背面のラベルで確認できます。</p>
    </div>
  </section>

  <!-- 型番・VESA の確認方法 -->
  <section id="guide" class="home-section" aria-labelledby="guide-title">
    <div class="container">
      <div class="home-guide">
        <div>
          <p class="home-eyebrow">Before you choose</p>
          <h2 id="guide-title">型番やVESAの確認方法が<br/>わからないときは</h2>
          <p class="home-section-lead">型番の確認場所と、テレビ背面の取付穴を確認する方法をご案内します。</p>
          <ol class="home-guide-points">
            <li><span class="home-num">1</span><span><b>型番：テレビ背面のラベル</b><small>「K-65XR80M2」のような英数字です。リモコンの設定画面や取扱説明書でも確認できます。</small></span></li>
            <li><span class="home-num">2</span><span><b>VESA：背面の取付穴の間隔</b><small>4つのネジ穴の「横×縦」の間隔（例：300×300mm）。型番を選べば、登録済みのVESAと照らし合わせて表示します。</small></span></li>
          </ol>
          <a class="home-button-outline" href="/guides/vesa/">確認方法を見る <Icon name="arrow" size={18}/></a>
        </div>
        <figure class="home-vesa-figure">
          <svg viewBox="0 0 320 220" role="img" aria-label="テレビ背面の取付穴（VESA）の、横と縦の間隔を示す図">
            <rect x="40" y="20" width="240" height="160" rx="10" fill="#E8E0D4" stroke="#D6CBBB" stroke-width="2"/>
            <rect x="120" y="150" width="80" height="14" rx="3" fill="#D6CBBB"/>
            <g fill="#FFFDF9" stroke="#7C5B3E" stroke-width="3"><circle cx="110" cy="62" r="8"/><circle cx="210" cy="62" r="8"/><circle cx="110" cy="132" r="8"/><circle cx="210" cy="132" r="8"/></g>
            <path d="M110 40H210M110 33v14M210 33v14M300 62V132M293 62h14M293 132h14" stroke="#1262ce" stroke-width="2"/>
            <text x="160" y="31" text-anchor="middle" font-size="14" font-weight="700" fill="#1262ce">横の間隔</text>
            <text x="306" y="204" text-anchor="end" font-size="14" font-weight="700" fill="#1262ce">縦の間隔</text>
            <text x="160" y="104" text-anchor="middle" font-size="13" fill="#5B544B">テレビ背面のイメージ</text>
          </svg>
          <figcaption>4つのネジ穴の間隔が、スタンドや金具の対応VESAと同じなら取り付けられます（重さ・画面サイズの条件もあります）。</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 暮らしのシーン（雰囲気づくり。操作の邪魔にならないよう、メーカー選択と確認方法より後に置く） -->
  <section class="home-section home-scenes" aria-labelledby="scenes-title">
    <div class="container">
      <p class="home-eyebrow">Scenes</p>
      <h2 id="scenes-title">テレビまわりが整うと、<br class="home-sp-only"/>部屋がひろくなる。</h2>
      <div class="home-scenes-grid">
        <!-- 写真：public/images/home/scene-living-stand-{600,1200}.webp（3:2）。壁際に寄せたスタンドの全体、テレビ台なし、窓の光は横から。 -->
        <figure class="home-scene">
          <div class="home-photo">
            <img src="/images/home/scene-living-stand-1200.webp" srcset="/images/home/scene-living-stand-600.webp 600w, /images/home/scene-living-stand-1200.webp 1200w" sizes="(max-width: 900px) 100vw, 560px" width="1536" height="1024" alt="壁際に寄せたテレビスタンドと、日の入るリビング" loading="lazy" decoding="async"/>
          </div>
          <figcaption><h3>リビングに、スタンドで。</h3><p>テレビ台がなくても置けて、足元の掃除もしやすくなります。高さを合わせれば、ソファからの見やすさも変わります。</p></figcaption>
        </figure>
        <!-- 写真：public/images/home/scene-office-wall-{600,1200}.webp（3:2）。会議室の壁に大画面を壁掛け、手前に木のテーブルと椅子。 -->
        <figure class="home-scene">
          <div class="home-photo">
            <img src="/images/home/scene-office-wall-1200.webp" srcset="/images/home/scene-office-wall-600.webp 600w, /images/home/scene-office-wall-1200.webp 1200w" sizes="(max-width: 900px) 100vw, 560px" width="1536" height="1024" alt="会議室の壁に掛けたテレビと、木のテーブル" loading="lazy" decoding="async"/>
          </div>
          <figcaption><h3>会議室に、壁掛けで。</h3><p>画面の位置を決めて固定すれば、机の上も配線もすっきり。大きな画面でも圧迫感を抑えられます。</p></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 適合情報の根拠（正確さを伝える） -->
  <section class="home-section home-trust-section" aria-labelledby="trust-title">
    <div class="container">
      <h2 id="trust-title" class="sr-only">TV FIT の適合情報について</h2>
      <ul class="home-trust">
        <li><span class="home-trust-icon"><Icon name="book" size={20}/></span><b>メーカー公式の情報が根拠</b><p>テレビの仕様と、スタンドメーカーの適合表をもとに掲載しています。</p></li>
        <li><span class="home-trust-icon"><Icon name="shield" size={20}/></span><b>確認の度合いを表示</b><p>「確認済み」と「仕様上の候補」を分けて、根拠と確認日も示します。</p></li>
        <li><span class="home-trust-icon"><Icon name="search" size={20}/></span><b>型番から3ステップ</b><p>メーカー、型番の順に選ぶだけ。専門用語を知らなくても探せます。</p></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* 案A「温かみのあるリビング」。色の値は src/styles/global.css の :root（--home-*）にまとめている。 */
  .home-hero{background:linear-gradient(180deg,#EFE7DB 0%,var(--home-bg) 100%);padding:48px 0 64px}
  .home-hero-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:56px;align-items:center}
  .home-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:700;letter-spacing:.18em;color:var(--home-wood-deep);text-transform:uppercase;margin-bottom:14px}
  .home-eyebrow::before{content:"";width:22px;height:1px;background:currentColor}
  .home-hero h1{font-family:var(--home-heading-font);font-weight:700;font-size:clamp(28px,3.2vw,40px);line-height:1.5;letter-spacing:.04em;margin-bottom:14px}
  .home-lead{color:var(--home-ink-soft);font-size:15px;margin-bottom:24px}
  .home-first-step{background:var(--home-surface);border:1px solid var(--home-line);border-radius:22px;padding:22px 22px 20px;box-shadow:var(--home-shadow)}
  .home-first-step-title{font-size:22px;font-weight:700;line-height:1.5;margin-bottom:4px}
  .home-first-step-title em{font-style:normal;color:var(--blue)}
  .home-first-step-text{color:var(--home-ink-soft);font-size:14px;margin:0 0 16px!important}
  .home-cta{display:flex;align-items:center;justify-content:center;gap:10px;min-height:56px;border-radius:999px;background:var(--blue);color:#fff;font-weight:700;font-size:17px}
  .home-cta:hover{background:#0B4FA8;color:#fff}
  .home-steps{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 0 0;padding:0}
  .home-steps li{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--home-ink-soft);background:var(--home-bg);border-radius:999px;padding:6px 10px 6px 6px}
  .home-steps span{flex:none;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:var(--home-greige);color:var(--home-ink)}
  .home-steps [aria-current="step"]{background:#E6EEFA;color:#0B4FA8}
  .home-steps [aria-current="step"] span{background:var(--blue);color:#fff}
  .home-help-link{display:inline-flex;align-items:center;gap:6px;margin-top:16px;font-size:14px;font-weight:700;color:var(--blue);text-decoration:underline;text-underline-offset:4px}
  .home-hero-visual{position:relative}
  .home-photo{margin:0;border-radius:22px;overflow:hidden;background:#E9E1D5;aspect-ratio:4/3;box-shadow:var(--home-shadow)}
  .home-photo svg,.home-photo img{display:block;width:100%;height:100%}
  .home-photo img{object-fit:cover;object-position:62% 50%}
  .home-vesa-card{position:absolute;left:-28px;bottom:-28px;width:224px;background:var(--home-surface);border:1px solid var(--home-line);border-radius:14px;padding:14px 14px 12px;box-shadow:var(--home-shadow)}
  .home-vesa-card p{margin-top:8px;font-size:12px;line-height:1.6;color:var(--home-ink-soft)}
  .home-vesa-card strong{color:var(--home-ink)}

  .home-section{padding:64px 0;scroll-margin-top:16px}
  .home-section h2{font-family:var(--home-heading-font);font-size:clamp(22px,3vw,30px);line-height:1.5;letter-spacing:.04em}
  .home-section-lead{margin-top:6px;color:var(--home-ink-soft);font-size:15px}
  .home-step-badge{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--blue);background:#E6EEFA;border-radius:999px;padding:4px 12px 4px 4px;margin-bottom:10px}
  .home-step-badge span{background:var(--blue);color:#fff;border-radius:999px;padding:1px 10px}

  .home-makers{background:var(--home-surface);border-block:1px solid var(--home-line)}
  .home-maker-grid{list-style:none;margin:24px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .home-maker-grid a{position:relative;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;text-align:left;gap:2px;min-height:96px;padding:16px 44px 16px 20px;border:1.5px solid var(--home-line);border-radius:14px;background:var(--home-bg);transition:border-color .15s,background-color .15s,transform .15s}
  .home-maker-grid a::after{content:"";position:absolute;right:20px;top:50%;width:10px;height:10px;border-top:2px solid var(--blue);border-right:2px solid var(--blue);transform:translateY(-50%) rotate(45deg)}
  .home-maker-grid a:hover{border-color:var(--blue);background:var(--home-surface);transform:translateY(-1px);color:inherit}
  .home-maker-name{font-size:22px;font-weight:700;letter-spacing:.04em;line-height:1.3;color:var(--home-ink)}
  .home-maker-sub{font-size:13px;color:var(--home-ink-soft)}
  .home-maker-grid .home-maker-unknown{background:transparent;border-style:dashed}
  .home-maker-unknown .home-maker-name{font-size:15px;color:#0B4FA8}
  .home-maker-note{display:flex;gap:8px;align-items:flex-start;margin-top:18px;font-size:14px;color:var(--home-ink-soft)}
  .home-maker-note :global(svg){margin-top:4px}

  .home-guide{display:grid;grid-template-columns:1.1fr .9fr;gap:32px;align-items:center;background:var(--home-greige);border-radius:22px;padding:36px}
  .home-guide-points{list-style:none;padding:0;margin:20px 0 24px;display:grid;gap:12px}
  .home-guide-points li{display:flex;gap:12px;align-items:flex-start;background:var(--home-surface);border-radius:14px;padding:14px 16px}
  .home-guide-points b{display:block;font-size:15px}
  .home-guide-points small{display:block;font-size:13px;color:var(--home-ink-soft);line-height:1.7}
  .home-num{flex:none;width:28px;height:28px;border-radius:50%;background:var(--home-wood-deep);color:#fff;display:grid;place-items:center;font-size:13px;font-weight:700;margin-top:2px}
  .home-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding:0 28px;border-radius:999px;border:2px solid var(--blue);color:var(--blue);background:var(--home-surface);font-weight:700}
  .home-button-outline:hover{background:var(--blue);color:#fff}
  .home-vesa-figure{margin:0;background:var(--home-surface);border-radius:14px;padding:24px}
  .home-vesa-figure svg{display:block;width:100%;height:auto}
  .home-vesa-figure figcaption{margin-top:12px;font-size:13px;color:var(--home-ink-soft);line-height:1.7}

  .home-scenes{padding-top:8px}
  .home-scenes-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:24px}
  .home-scene{margin:0}
  .home-scene .home-photo{aspect-ratio:3/2}
  .home-scene figcaption{padding:14px 4px 0}
  .home-scene h3{font-family:var(--home-heading-font);font-size:19px;letter-spacing:.04em;margin-bottom:4px}
  .home-scene p{font-size:14px;color:var(--home-ink-soft)}

  .home-trust-section{padding-top:0}
  .home-trust{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .home-trust li{background:var(--home-surface);border:1px solid var(--home-line);border-radius:14px;padding:20px}
  .home-trust b{display:block;font-size:16px;margin-bottom:4px}
  .home-trust p{font-size:14px;color:var(--home-ink-soft)}
  .home-trust-icon{width:40px;height:40px;border-radius:12px;background:var(--home-greige);display:grid;place-items:center;color:var(--home-wood-deep);margin-bottom:12px}

  .home-sp-only{display:none}
  @media (max-width:860px){
    .home-hero{padding:16px 0 36px}
    .home-hero-grid{grid-template-columns:1fr;gap:20px}
    .home-hero-visual{order:-1}
    .home-hero-visual .home-photo{aspect-ratio:16/10}
    .home-hero-visual .home-photo img{object-position:62% 70%}
    .home-vesa-card,.home-hero .home-eyebrow,.home-pc-only{display:none}
    .home-hero h1{font-size:26px;margin-bottom:6px}
    .home-lead{font-size:14px;margin-bottom:14px}
    .home-first-step{padding:18px 16px 16px}
    .home-first-step-title{font-size:20px}
    .home-maker-grid{grid-template-columns:repeat(2,1fr);gap:10px}
    .home-maker-grid a{min-height:76px;padding:12px 36px 12px 16px}
    .home-maker-grid a::after{right:14px}
    .home-maker-name{font-size:19px}
    .home-maker-unknown .home-maker-name{font-size:14px}
    .home-maker-grid .home-maker-unknown{padding-right:30px}
    .home-guide{grid-template-columns:1fr;padding:22px 16px;gap:20px}
    .home-button-outline{width:100%}
    .home-scenes-grid,.home-trust{grid-template-columns:1fr}
  }
  @media (max-width:700px){
    .home-section{padding:44px 0}
    .home-sp-only{display:inline}
  }
  @media (max-width:380px){ .home-steps li{font-size:12px;padding-right:6px} }
  @media (prefers-reduced-motion:reduce){ .home-maker-grid a{transition:none} }
</style>
