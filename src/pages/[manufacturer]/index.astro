---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import ModelList from '../../components/ModelList.astro';
import { isIndexableTelevision, televisionPath, type Catalog } from '../../lib/data';
import { getPublishedCatalog } from '../../lib/cms-catalog';
import { getManufacturers, isIndexableManufacturer, type Manufacturer } from '../../lib/manufacturers';
import { breadcrumbSchema, canonicalUrl } from '../../lib/seo';

interface Props { manufacturer?: Manufacturer; catalog?: Catalog; }
// 一覧の表示に適合情報は使わない。インデックス可否は、型番ごとの適合情報を
// 先頭から確認して1件見つかった時点で決める（全件を読むと件数に比例して遅くなるため）。
const catalog = Astro.props.catalog ?? await getPublishedCatalog({ compatibility: 'none' });
const manufacturer = Astro.props.manufacturer ?? getManufacturers(catalog.televisions).find(item => item.slug === Astro.params.manufacturer);
if (!manufacturer) return Astro.rewrite('/404/');
let indexable = false;
if (Astro.props.catalog) indexable = isIndexableManufacturer(manufacturer, catalog);
else for (const television of manufacturer.televisions) {
  // 仕様が欠けている型番は適合情報に関係なくインデックス対象外なので、読みに行かない。
  if ([television.source_url, television.screen_inches, television.weight_kg, television.vesa_width_mm, television.vesa_height_mm].some(value => value === null)) continue;
  if (isIndexableTelevision(television, await getPublishedCatalog({ compatibility: { televisionId: television.id } }))) { indexable = true; break; }
}
const televisions = manufacturer.televisions;
const structuredData: unknown[] = [breadcrumbSchema([
  { name: 'ホーム', path: '/' },
  { name: `${manufacturer.name}のテレビ型番一覧`, path: manufacturer.url },
])];
if (televisions.length > 0) structuredData.push({
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: `${manufacturer.name}のテレビ型番一覧`, numberOfItems: televisions.length,
  itemListElement: televisions.map((television, index) => ({
    '@type': 'ListItem', position: index + 1,
    name: television.model, url: canonicalUrl(televisionPath(television)),
  })),
});
---
<BaseLayout title={`${manufacturer.name}のテレビ型番一覧・スタンド対応検索｜TV FIT`} description={`${manufacturer.name}のテレビ型番一覧です。お使いの正式な型番を選択して、テレビスタンド・壁掛け金具の対応情報、VESA、確認の根拠をご覧いただけます。`} indexable={indexable} structuredData={structuredData}>
  <div class="container manufacturer-page">
    <Breadcrumbs items={[{ name: `${manufacturer.name}のテレビ型番一覧` }]}/>
    <nav class="manufacturer-navigation" aria-label="選択の進み具合"><a href="/#manufacturers">01 メーカーを選ぶ</a><span aria-hidden="true">→</span><span aria-current="step">02 型番を選ぶ</span><span aria-hidden="true">→</span><span>03 対応情報を見る</span></nav>
    <header class="manufacturer-header"><p class="eyebrow">STEP 02 / SELECT YOUR TV</p><h1>{manufacturer.name}の<br class="mobile-break"/>テレビ型番を選ぶ</h1><p>お使いのテレビと同じ、正式な型番を選んでください。</p><a class="text-link" href="/#manufacturers">← メーカーを選び直す</a></header>
    <section class="manufacturer-models" aria-labelledby="manufacturer-models-title"><div class="section-heading"><div><h2 id="manufacturer-models-title">{manufacturer.name}のテレビ型番一覧</h2></div><p>登録済み {televisions.length} 型番</p></div>
      {televisions.length > 0 ? <ModelList televisions={televisions} manufacturerName={manufacturer.name}/> : <div class="model-list-empty"><span class="model-list-empty-icon"><Icon name="tv" size={31}/></span><h3>{manufacturer.name}の型番データを準備中です</h3><p>現在、このメーカーのテレビ型番は登録されていません。<br/>出典を確認できた型番から順次掲載します。</p><a class="button-secondary" href="/#manufacturers">メーカー選択に戻る <Icon name="arrow" size={16}/></a></div>}
    </section>
    <aside class="manufacturer-help"><Icon name="info" size={20}/><div><h2>型番がわからないときは</h2><p>テレビ背面のラベルや取扱説明書に記載された型番を、末尾の記号まで確認してください。適合情報は公式の出典を確認して登録し、確認済みと未確認を区別して表示します。</p><a class="text-link" href="/guides/vesa/">VESAの確認方法を見る <Icon name="arrow" size={15}/></a></div></aside>
  </div>
</BaseLayout>
