---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import {manufacturerSlug, modelSlug, isIndexableTelevision, televisionPath, formatReleaseDate, type Television, type Catalog} from '../../lib/data';
import {breadcrumbSchema, canonicalUrl} from '../../lib/seo';
import {manufacturerPath} from '../../lib/manufacturers';
import {getPublishedCatalog} from '../../lib/cms-catalog';
import {getPublishedRanking, rankingLabel, type TvRanking} from '../../lib/tv-ranking';
import {sortByStatus} from '../../lib/fit';
import {getPublishedOffers} from '../../lib/published-offers';
import {getDirectAffiliateIds} from '../../lib/direct-affiliate';
import {primaryOffer, sortByAvailability, displayOffer} from '../../lib/offers';
interface Props { television?:Television;catalog?:Catalog;ranking?:TvRanking|null; }
const products=Astro.props.catalog??await getPublishedCatalog({compatibility:'none'});
const tv=Astro.props.television??products.televisions.find(item=>manufacturerSlug(item.manufacturer)===Astro.params.manufacturer&&modelSlug(item.model)===Astro.params.model);
if(!tv)return Astro.rewrite('/404/');
// この型番の適合情報だけを読む（全件を読むと適合情報の件数に比例して遅くなるため）。
const catalog=Astro.props.catalog??await getPublishedCatalog({compatibility:{televisionId:tv.id}});
const ranking=Astro.props.ranking!==undefined?Astro.props.ranking:await getPublishedRanking();
const salesRank=rankingLabel(ranking?.ranks.get(tv.id),products.televisions.length,ranking?.asOf);
const pairs=catalog.compatibility.filter(entry=>entry.television_id===tv.id);
const offers=await getPublishedOffers();
const directIds=await getDirectAffiliateIds();
const now=new Date();
const allEntries=catalog.stands.map(stand=>({stand,compatibility:pairs.find(entry=>entry.stand_id===stand.id)??null,offer:primaryOffer(offers.get(stand.id),now),offers:offers.get(stand.id)??[],directIds}));
const availabilityOf=(entry:{offer:ReturnType<typeof primaryOffer>})=>displayOffer(entry.offer,now)?.availability;
// 販売終了の商品は購入候補から外し、ページ下部の「販売終了品」にまとめる（適合情報は残す）。
const ended=allEntries.filter(entry=>availabilityOf(entry)==='discontinued');
const entries=sortByAvailability(allEntries.filter(entry=>!ended.includes(entry)),availabilityOf);
// 個別適合確認済みと仕様上の候補を同じ一覧に並べる（区分はカードのバッジで示す）。非対応・判断材料不足は出さない。
const fits=(entry:(typeof entries)[number])=>entry.compatibility?.status==='confirmed'||entry.compatibility?.status==='candidate';
const ordered=sortByAvailability(sortByStatus(entries.filter(fits)),availabilityOf);
const stands=ordered.filter(entry=>entry.stand.stand_type!=='wall');
const wall=ordered.filter(entry=>entry.stand.stand_type==='wall');
const countOf=(list:typeof ordered,status:'confirmed'|'candidate')=>list.filter(entry=>entry.compatibility?.status===status).length;
const endedFits=ended.filter(fits);
const checkedAt=pairs.flatMap(entry=>entry.checked_at?[entry.checked_at]:[]).sort().at(-1);
const name=`${tv.manufacturer} ${tv.model}`;
const breadcrumb=breadcrumbSchema([{name:'ホーム',path:'/'},{name:tv.manufacturer,path:manufacturerPath(tv.manufacturer)},{name,path:televisionPath(tv)}]);
const schema={'@context':'https://schema.org','@type':'WebPage',name:`${name} のテレビスタンド・壁掛け金具の適合情報`,url:canonicalUrl(televisionPath(tv)),...(checkedAt?{dateModified:checkedAt}:{})};
---
<BaseLayout title={`${name} 対応テレビスタンド・壁掛け金具・VESA｜TV FIT`} description={`${name}の画面サイズ、重量、VESA取付穴間隔とテレビスタンド・壁掛け金具の適合情報。個別適合確認済み、仕様上の候補、非対応、判断材料不足を区別して確認できます。`} indexable={isIndexableTelevision(tv,catalog)} structuredData={[breadcrumb,schema]}>
  <div class="container detail-page"><Breadcrumbs items={[{name:tv.manufacturer,path:manufacturerPath(tv.manufacturer)},{name}]}/><header class="detail-header"><p class="eyebrow">TV COMPATIBILITY</p><p class="detail-manufacturer">{tv.manufacturer}</p><h1>{tv.model}</h1><p>テレビスタンド・壁掛け金具の適合情報</p>{salesRank&&<p class="detail-rank">{salesRank}</p>}<div class="detail-meta"><span>適合情報の最終確認：{checkedAt??'未確認'}</span>{tv.source_url && <a href={tv.source_url} target="_blank" rel="noopener noreferrer">テレビの公式仕様 <Icon name="external" size={14}/></a>}</div></header>
    <dl class="tv-specifications"><div><dt>画面サイズ</dt><dd>{tv.screen_inches??'未確認'}{tv.screen_inches!==null&&<small> インチ</small>}</dd></div><div><dt>テレビ本体の重量</dt><dd>{tv.weight_kg??'未確認'}{tv.weight_kg!==null&&<small> kg</small>}</dd></div><div><dt>VESA取付穴（横 × 縦）</dt><dd>{tv.vesa_width_mm!==null&&tv.vesa_height_mm!==null?`${tv.vesa_width_mm} × ${tv.vesa_height_mm}`:'未確認'}{tv.vesa_width_mm!==null&&<small> mm</small>}</dd></div><div><dt>発売日</dt><dd>{tv.release_date?formatReleaseDate(tv.release_date):'未確認'}</dd></div></dl>
    <aside class="notice"><Icon name="info"/><p>重量は付属スタンドを除くテレビ本体の値を確認してください。VESAと耐荷重の一致だけでは、取付適合を保証できません。背面形状、ネジ径・長さ、スペーサー、端子の干渉を確認してください。</p></aside>
    <div class="tv-sticky" aria-label="調べているテレビ"><p class="tv-sticky-name"><span>{tv.manufacturer}</span> {tv.model}</p><p class="tv-sticky-specs">{tv.screen_inches!==null&&<span>{tv.screen_inches}型</span>}{tv.weight_kg!==null&&<span>{tv.weight_kg} kg</span>}{tv.vesa_width_mm!==null&&tv.vesa_height_mm!==null&&<span>VESA {tv.vesa_width_mm}×{tv.vesa_height_mm}</span>}</p><a class="tv-sticky-change" href="/#manufacturers">別のテレビ</a></div>
    {/* JS が動くときだけ、下の2つの一覧を切り替えるタブにする（src/scripts/product-tabs.ts）。JS が無いときは両方の一覧へのページ内リンクのまま。 */}
    <div class="detail-toc" data-product-tabs><a href="#stands" id="tab-stands" data-tab="stands" data-count={stands.length}><span>対応するスタンド</span><strong>{stands.length}件</strong></a><a href="#wall" id="tab-wall" data-tab="wall" data-hash="mounts" data-count={wall.length}><span>対応する壁掛け金具</span><strong>{wall.length}件</strong></a></div>
    <p class="advertising-notice">広告：購入先へのリンクにはアフィリエイトリンクを含む場合があります。価格・在庫は表示の日時時点のものです。最新の情報は購入先でご確認ください。</p>
    <p class="fit-legend"><span><span class="status-badge status-confirmed">確認済み</span>メーカー等がこの型番との適合を個別に確認した商品</span><span><span class="status-badge status-candidate">仕様上適合</span>VESAと耐荷重、推奨のテレビサイズが合う商品</span></p>
    <section id="stands" class="product-section" data-tab-panel="stands"><p class="eyebrow">STANDS</p><h2>対応するテレビスタンド</h2><p class="fit-count">確認済み {countOf(stands,'confirmed')}件・仕様上適合 {countOf(stands,'candidate')}件</p><div class="product-grid">{stands.map(entry=><ProductCard television={tv} {...entry}/>)}</div>{stands.length===0&&<div class="empty-state">このテレビに対応するスタンドは登録されていません。</div>}</section>
    <section id="wall" class="product-section" data-tab-panel="wall"><p class="eyebrow">WALL MOUNTS</p><h2>対応する壁掛け金具</h2><p>商品の適合に加え、壁の下地・強度と施工条件を専門業者に確認してください。</p><p class="fit-count">確認済み {countOf(wall,'confirmed')}件・仕様上適合 {countOf(wall,'candidate')}件</p><div class="product-grid">{wall.map(entry=><ProductCard television={tv} {...entry}/>)}</div>{wall.length===0&&<div class="empty-state">このテレビに対応する壁掛け金具は登録されていません。</div>}</section>
    {endedFits.length>0&&<details class="other-products" id="ended-products"><summary>販売終了品を見る（{endedFits.length}件）</summary><p>販売先で販売終了を確認した商品です。すでにお持ちの方向けに適合情報だけを残しています。</p><div class="product-grid">{endedFits.map(entry=><ProductCard television={tv} {...entry}/>)}</div></details>}
    <section class="installation-notes"><h2>取り付け前の確認事項</h2><ul><li>公式適合表でテレビと金具の正式型番・末尾記号まで確認してください。</li><li>取扱説明書でネジの径・長さ・本数、締付条件、スペーサーの指定を確認してください。</li><li>テレビ背面の段差、突起、端子・配線と金具が干渉しないか確認してください。</li><li>床置きは設置面と転倒防止策、壁掛けは壁の下地・強度と施工条件を確認してください。</li><li>情報は確認日時点のものです。判断できない場合はメーカーまたは施工業者へご相談ください。</li></ul><a class="text-link" href="/guides/vesa/">VESAと取付条件の確認方法 <Icon name="arrow" size={16}/></a></section>
  </div>
  <script>
    import '../../scripts/product-tabs';
  </script>
</BaseLayout>
