---
import type {Television, Stand, Compatibility} from '../lib/data';
import StatusBadge from './StatusBadge.astro';
import {fitBreakdown} from '../lib/fit';
import {displayOffer, availabilityLabels, type Offer} from '../lib/offers';
interface Props { television:Television; entries:{stand:Stand;compatibility:Compatibility|null;offer?:Offer|null}[]; }
const {television,entries} = Astro.props;
const types = {floor:'フロア',tabletop:'卓上',wall:'壁掛け'};
---
<section class="comparison-section" data-comparison-root aria-labelledby="comparison-title">
  <div class="section-heading"><div><p class="eyebrow">COMPARE</p><h2 id="comparison-title">商品を比較する</h2></div></div>
  <p>最大4商品を選択して比較できます。横にスクロールすると、すべての項目を確認できます。</p>
  {entries.length > 0 ? <>
    <div class="comparison-toolbar"><button class="button button-small" type="button" data-compare-selected disabled>選んだ商品を比較</button><button class="button-secondary button-small" type="button" data-compare-reset>すべて表示</button><span role="status" data-compare-status>商品を選択してください（最大4件）。</span></div>
    <div class="table-scroll" role="region" aria-label="商品比較表（横スクロール可能）" tabindex="0"><table class="comparison-table"><caption class="sr-only">{television.manufacturer} {television.model} の商品比較。適合確認済みと候補は異なります。</caption><thead><tr><th scope="col">比較</th><th scope="col">商品名・メーカー</th><th scope="col">タイプ</th><th scope="col">耐荷重</th><th scope="col">VESA {television.vesa_width_mm!==null&&television.vesa_height_mm!==null?`${television.vesa_width_mm}×${television.vesa_height_mm}`:'（横×縦）'}</th><th scope="col">適合ステータス</th><th scope="col">価格・在庫</th><th scope="col">商品・購入先</th></tr></thead><tbody>{entries.map(({stand,compatibility,offer})=>{
      const status=compatibility?.status??'unknown';
      const fit=fitBreakdown(television,stand);
      const sale=displayOffer(offer);
      return <tr data-compare-row={stand.id}><td><input type="checkbox" data-compare-check={stand.id} aria-label={`${stand.manufacturer} ${stand.sku} を比較に追加`}/></td><th scope="row">{stand.sku}<span class="table-maker">{stand.manufacturer}</span></th><td>{types[stand.stand_type]}</td><td>{stand.max_weight_kg} kg{fit.weightMarginKg!==null&&<span class="table-maker">{fit.weightMarginKg>=0?`余裕 ${fit.weightMarginKg} kg`:`${-fit.weightMarginKg} kg 超過`}</span>}</td><td>{fit.vesaMatch===null?stand.vesa_patterns.map(p=><span class="vesa-pattern">{p.width} × {p.height} mm</span>):fit.vesaMatch?<span class="fit-mark fit-ok">✓ 対応</span>:<span class="fit-mark fit-ng">× 対応表になし</span>}</td><td><StatusBadge status={status}/></td><td>{sale?<>{sale.price_jpy!==null&&<strong class="table-price">¥{sale.price_jpy.toLocaleString('ja-JP')}</strong>}<span class="table-maker">{availabilityLabels[sale.availability]}</span>{sale.priceAt&&<span class="table-maker">{sale.priceAt}</span>}</>:<span class="table-maker">購入先で確認</span>}</td><td><a href={stand.source_url} target="_blank" rel="noopener noreferrer">商品詳細 ↗</a>{stand.product_url && status!=='incompatible' && (sale?.purchasable??true) && <a href={stand.product_url} target="_blank" rel="sponsored nofollow noopener noreferrer" data-affiliate-link data-tv-id={television.id} data-stand-id={stand.id} data-status={status}>購入先（広告）↗</a>}</td></tr>;
    })}</tbody></table></div>
    <noscript><p>JavaScriptが無効の場合も、全商品の比較表をご覧いただけます。</p></noscript>
  </> : <div class="empty-state"><p>比較できる商品はまだ登録されていません。</p></div>}
</section>
<script>import '../scripts/compare';</script>
