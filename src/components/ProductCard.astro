---
import type {Television, Stand, Compatibility} from '../lib/data';
import {fitBreakdown} from '../lib/fit';
import {confirmedNotesText, candidateSpecLine, candidateFitText, candidateCondition} from '../lib/compatibility-notes';
import {displayOffer, availabilityLabels, malls, mallSearchQuery, shopForUrl, YAHOO_SHOP, type Offer} from '../lib/offers';
import StatusBadge from './StatusBadge.astro';
import Icon from './Icon.astro';
interface Props { television:Television; stand:Stand; compatibility:Compatibility|null; offer?:Offer|null; offers?:readonly Offer[]; }
const {television,stand,compatibility,offer,offers} = Astro.props;
const sale = displayOffer(offer);
const status = compatibility?.status ?? 'unknown';
const standType = {floor:'フロアスタンド', tabletop:'卓上スタンド', wall:'壁掛け金具'};
const fit = fitBreakdown(television, stand);
const tvVesa = fit.vesaMatch === null ? null : `${television.vesa_width_mm} × ${television.vesa_height_mm}`;
const allPatterns = stand.vesa_patterns.map(p=>`${p.width} × ${p.height}`).join(' / ');
const notes = compatibility?.notes ? (status === 'confirmed' ? confirmedNotesText(compatibility.notes) : compatibility.notes) : '';
const condition = status === 'candidate' && compatibility?.notes ? candidateCondition(compatibility.notes) : null;
// offer は在庫・価格の表示に使う代表の1件。購入ボタンは販売店ごとの記録（offers）から作る。
const shopOffers = offers ?? (offer ? [offer] : []);
const directShop = stand.product_url ? shopForUrl(stand.product_url) : null;
const direct = displayOffer(shopOffers.find(item => item.shop === directShop && item.shop !== YAHOO_SHOP));
// ASP の商品データにアフィリエイトリンクがあればそれを使い、無ければ登録済みの販売ページへ直接リンクする。
const purchaseUrl = direct?.affiliateUrl ?? stand.product_url;
const isAd = !!direct?.affiliateUrl;
const showPurchase = !!purchaseUrl && status !== 'incompatible' && (direct?.purchasable ?? true);
// Amazon・楽天市場は型番の検索結果へ。Yahoo!ショッピングは公式ストアの商品が取れていればその商品ページ
// （アフィリエイトリンク）へ、取れていなければ検索結果へ。
const yahooRecord = shopOffers.find(item => item.shop === YAHOO_SHOP && item.last_success_at) ?? null;
const yahooSale = displayOffer(yahooRecord);
const query = mallSearchQuery(stand);
const mallLinks = malls.map(mall => {
  if (mall.id === 'yahoo' && yahooRecord && yahooSale) {
    return { id: mall.id, name: mall.name, href: yahooSale.affiliateUrl ?? yahooRecord.url, search: false, ad: !!yahooSale.affiliateUrl, pvImgUrl: yahooSale.pvImgUrl, price: yahooSale.price_jpy, availability: yahooSale.availability };
  }
  return { id: mall.id, name: mall.name, href: mall.search(query), search: true, ad: false, pvImgUrl: null, price: null, availability: null };
});
const showMalls = status !== 'incompatible';
---
<article class:list={['product-card', `product-${status}`]} data-compatibility-view data-tv-id={television.id} data-status={status}>
  {sale?.imageUrl && <div class="product-image"><img src={sale.imageUrl} alt={`${stand.manufacturer} ${stand.sku}`} width="240" height="240" loading="lazy" decoding="async" referrerpolicy="no-referrer"/></div>}
  <div class="product-card-heading"><StatusBadge status={status}/><span class="product-type">{standType[stand.stand_type]}</span></div>
  <p class="product-manufacturer">{stand.manufacturer}</p><h3>{stand.sku}</h3>
  <dl class="product-specs fit-breakdown">
    <div class:list={['fit-row', fit.weightMarginKg === null ? 'fit-unknown' : fit.weightMarginKg >= 0 ? 'fit-ok' : 'fit-ng']}>
      <dt>耐荷重</dt>
      <dd><span class="fit-value">{stand.max_weight_kg} kg</span>{fit.weightMarginKg !== null && <span class="fit-detail">{fit.weightMarginKg >= 0 ? `本体 ${television.weight_kg} kg・余裕 ${fit.weightMarginKg} kg` : `本体 ${television.weight_kg} kg を ${-fit.weightMarginKg} kg 超過`}</span>}</dd>
    </div>
    <div class:list={['fit-row', fit.vesaMatch === null ? 'fit-unknown' : fit.vesaMatch ? 'fit-ok' : 'fit-ng']}>
      <dt>VESA</dt>
      <dd>{tvVesa === null
        ? <span class="fit-value">{allPatterns} mm</span>
        : <><span class="fit-value">{tvVesa} mm</span><span class="fit-detail">{fit.vesaMatch ? 'このテレビの取付穴に対応' : 'このテレビの取付穴は対応表にありません'}</span></>}</dd>
    </div>
  </dl>
  {tvVesa !== null && <details class="product-more"><summary>対応VESAをすべて見る（{stand.vesa_patterns.length}通り）</summary><p class="vesa-all">{allPatterns} mm</p></details>}
  {status === 'unknown' && <p class="candidate-warning">このテレビとの適合を判断できる情報が不足しています。</p>}
  {status === 'incompatible' && <p class="incompatible-warning">この組み合わせは非対応として記録されています。購入候補から除外してください。</p>}
  {status === 'candidate'
    ? <details class="product-more"><summary>適合の根拠と取付時の注意</summary>
        {candidateSpecLine(television) && <p class="product-notes">{candidateSpecLine(television)}</p>}
        <p class="product-notes">{candidateFitText}</p>
        {condition && <p class="product-notes">{condition}</p>}
        {television.source_url && <p class="product-notes">出典：<a href={television.source_url} target="_blank" rel="noopener noreferrer">{television.manufacturer} {television.model} の仕様（メーカー公式） <Icon name="external" size={12}/></a></p>}
      </details>
    : notes && <details class="product-more"><summary>適合の根拠と取付時の注意</summary><p class="product-notes">{notes}</p></details>}
  <div class="product-sources"><a href={stand.source_url} target="_blank" rel="noopener noreferrer">公式の商品詳細 <Icon name="external" size={13}/></a>{compatibility?.evidence_url && <a href={compatibility.evidence_url} target="_blank" rel="noopener noreferrer">適合判断の出典 <Icon name="external" size={13}/></a>}{compatibility?.checked_at && <span>確認日：<time datetime={compatibility.checked_at}>{compatibility.checked_at}</time></span>}</div>
  {sale && status !== 'incompatible' && <div class:list={['offer-info', `offer-${sale.availability}`]}>
    <span class="offer-availability">{availabilityLabels[sale.availability]}</span>
    {sale.price_jpy !== null && <strong class="offer-price">¥{sale.price_jpy.toLocaleString('ja-JP')}<small>（税込）</small></strong>}
    <span class="offer-meta">{sale.shopName}{sale.priceAt && `・${sale.priceAt}`}</span>
    {sale.availability === 'discontinued' && <span class="offer-meta">販売先で販売終了を確認しました。</span>}
  </div>}
  {showPurchase && <div class="purchase-row">
    <a class="button affiliate-button" href={purchaseUrl} target="_blank" rel="sponsored nofollow noopener" data-affiliate-link data-tv-id={television.id} data-stand-id={stand.id} data-status={status}>直販サイト <Icon name="external" size={16}/></a>
    {isAd && <span class="pr-label" title="アフィリエイト広告のリンクです">PR</span>}
    {isAd && direct?.pvImgUrl && <img class="ad-pixel" src={direct.pvImgUrl} width="1" height="1" alt=""/>}
  </div>}
  {showMalls && <div class="mall-links">
    <div class="mall-row">{mallLinks.map(link => <span class="mall-item">
      <a class="mall-button" href={link.href} target="_blank" rel={link.ad ? 'sponsored nofollow noopener' : 'nofollow noopener'} data-mall-link={link.id} data-tv-id={television.id} data-stand-id={stand.id} data-status={status}>
        <span>{link.name}</span>
        {link.price !== null ? <small class="mall-price">¥{link.price.toLocaleString('ja-JP')}{link.availability && link.availability !== 'unknown' && `・${availabilityLabels[link.availability]}`}</small> : link.search && <small>検索結果</small>}
      </a>
      {link.ad && <span class="pr-label" title="アフィリエイト広告のリンクです">PR</span>}
      {link.ad && link.pvImgUrl && <img class="ad-pixel" src={link.pvImgUrl} width="1" height="1" alt=""/>}
    </span>)}</div>
  </div>}
</article>
