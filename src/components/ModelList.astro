---
import Icon from './Icon.astro';
import { televisionPath, formatReleaseDate, type Television } from '../lib/data';
import { screenSizeOptions, sortModelsForDisplay, modelSortOrders, modelSortLabels, defaultModelSortOrder } from '../lib/model-filter';
import { rankingLabel, type TvRanking } from '../lib/tv-ranking';
interface Props {
  televisions: Television[];
  manufacturerName: string;
  /** 売れ筋順位（楽天市場ランキングを当サイト掲載機種内で振り直したもの）。 */
  ranking?: TvRanking | null;
  /** 順位の分母（当サイトに掲載しているテレビの総数）。 */
  rankingTotal?: number;
}
const { televisions: unsorted, manufacturerName, ranking = null, rankingTotal = 0 } = Astro.props;
const rankOf = (id: string) => ranking?.ranks.get(id) ?? null;
// 並び順は構造化データ（メーカーページの ItemList）と同じ関数で決める。
const televisions = sortModelsForDisplay(unsorted, ranking?.ranks);
const sizes = screenSizeOptions(televisions.map(television => television.screen_inches));
---
<div class="model-filter-root" data-model-filter-root>
  <form class="model-filter" role="search" aria-label={`${manufacturerName}の型番を絞り込む`}>
    <div class="model-filter-field model-filter-query">
      <label for="model-filter-query">型番で絞り込む</label>
      <input id="model-filter-query" type="search" data-model-filter-query placeholder="例：55X80L" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search"/>
    </div>
    <div class="model-filter-field model-filter-size">
      <label for="model-filter-size">画面サイズ</label>
      <select id="model-filter-size" data-model-filter-size>
        <option value="">すべてのサイズ</option>
        {sizes.map(size => <option value={String(size)}>{size}インチ</option>)}
      </select>
    </div>
    <div class="model-filter-field model-filter-sort">
      <label for="model-filter-sort">並び順</label>
      <select id="model-filter-sort" data-model-filter-sort>
        {modelSortOrders.map(order => <option value={order} selected={order === defaultModelSortOrder}>{modelSortLabels[order]}</option>)}
      </select>
    </div>
    <button type="button" class="model-filter-reset" data-model-filter-reset hidden>条件をクリア</button>
  </form>
  <p class="model-filter-status" data-model-filter-status role="status" aria-live="polite">{televisions.length}件の型番を表示しています。</p>
  <ul class="model-list" data-model-list aria-label={`${manufacturerName}のテレビ型番一覧`}>
    {televisions.map(television => <li data-model-item data-model={television.model} data-size={television.screen_inches === null ? '' : String(television.screen_inches)} data-release={television.release_date ?? ''} data-rank={rankOf(television.id) ?? ''}>
      <a class="model-card" data-model-link data-tv-result-link data-tv-id={television.id} data-manufacturer={television.manufacturer} href={televisionPath(television)}>
        <div class="model-card-body"><span class="model-card-name">{television.model}</span>
          {rankingLabel(rankOf(television.id), rankingTotal, ranking?.asOf) && <span class="model-card-rank">{rankingLabel(rankOf(television.id), rankingTotal, ranking?.asOf)}</span>}
          <span class="model-card-specs">
            {television.screen_inches !== null && <span>{television.screen_inches}インチ</span>}
            {television.vesa_width_mm !== null && television.vesa_height_mm !== null && <span>VESA {television.vesa_width_mm} × {television.vesa_height_mm} mm</span>}
            {television.release_date && <span>{formatReleaseDate(television.release_date)}発売</span>}
          </span>
          <span class="model-card-action">対応情報を見る</span>
        </div>
        <Icon name="arrow" size={19}/>
      </a>
    </li>)}
  </ul>
  <p class="model-filter-empty" data-model-filter-empty hidden>条件に合う型番がありません。型番の一部を短くするか、画面サイズを「すべてのサイズ」に戻してお試しください。</p>
</div>
<script>
  import '../scripts/model-filter';
</script>
