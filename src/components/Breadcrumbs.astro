---
interface Props { items: {name:string;path?:string}[]; }
const {items} = Astro.props;
---
<nav class="breadcrumbs" aria-label="パンくずリスト"><ol><li><a href="/">ホーム</a></li>{items.map((item)=><li>{item.path ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}</li>)}</ol></nav>
